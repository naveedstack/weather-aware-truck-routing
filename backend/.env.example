# Copy to backend/.env for local development. Never commit backend/.env.

# TomTom API key (routing, geocoding and city suggestions): https://developer.tomtom.com
TOMTOM_API_KEY=

# Any long random string. Required unless DJANGO_DEBUG=true.
DJANGO_SECRET_KEY=

# true for local development only.
DJANGO_DEBUG=true

# Extra comma-separated host names to serve. localhost is allowed automatically when DEBUG is on,
# and on Vercel any *.vercel.app host and the production domain are allowed automatically.
DJANGO_ALLOWED_HOSTS=
